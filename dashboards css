:root {
  --bg: #080c14;
  --panel: #0d121c;
  --panel-2: #101722;
  --panel-3: #151c28;

  --border: #202938;
  --border-light: #293343;

  --text: #f3f6fa;
  --muted: #7f8a9b;
  --muted-2: #566173;

  --green: #00c98b;
  --green-bright: #0be39b;
  --green-dark: #063c32;

  --red: #ff2453;
  --red-dark: #481421;

  --purple: #7761dc;
  --yellow: #e9bd3b;

  --sidebar-width: 292px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Inter", sans-serif;
  background: #060a10;
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
}

button,
a {
  font-family: inherit;
}

button {
  border: 0;
  cursor: pointer;
}

a {
  text-decoration: none;
  color: inherit;
}


/* ================================
   APPLICATION
================================ */

.app {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% -20%, rgba(0, 201, 139, 0.05), transparent 35%),
    var(--bg);
}


/* ================================
   TOP BAR
================================ */

.topbar {
  height: 64px;
  background: #0d131d;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18px;
  position: sticky;
  top: 0;
  z-index: 100;
}

.top-left {
  display: flex;
  align-items: center;
  gap: 15px;
}

.menu-btn {
  width: 34px;
  height: 34px;
  background: transparent;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  padding: 5px;
}

.menu-btn span {
  width: 18px;
  height: 2px;
  border-radius: 5px;
  background: #8792a3;
}

.mobile-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
}

.mobile-logo,
.brand-icon {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  display: grid;
  place-items: center;
  background: var(--green);
  color: #03120e;
  font-weight: 900;
}

.demo-badge {
  background: rgba(0, 201, 139, 0.09);
  color: var(--green);
  border: 1px solid rgba(0, 201, 139, 0.18);
  border-radius: 20px;
  padding: 5px 11px;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1px;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.balance-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #141b27;
  border: 1px solid var(--border);
  color: var(--text);
  padding: 6px 10px;
  border-radius: 22px;
}

.balance-avatar {
  width: 23px;
  height: 23px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #0a463a;
  color: var(--green);
  font-size: 10px;
  font-weight: 800;
}

.balance-btn span:nth-child(2) {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.balance-btn small {
  color: var(--muted);
  font-size: 7px;
}

.balance-btn strong {
  font-size: 11px;
}

.arrow {
  color: var(--muted);
}

.deposit-btn {
  background: var(--green);
  color: #001a12;
  font-size: 11px;
  font-weight: 800;
  border-radius: 18px;
  padding: 9px 16px;
}

.notification-btn {
  background: transparent;
  color: #778294;
  font-size: 20px;
}


/* ================================
   MARKET BAR
================================ */

.market-bar {
  min-height: 58px;
  background: #0a0f18;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 18px;
}

.market-tabs {
  display: flex;
  align-items: center;
  gap: 5px;
}

.market-tab {
  color: #647083;
  background: transparent;
  padding: 9px 13px;
  border-radius: 15px;
  font-size: 10px;
}

.market-tab.active {
  color: #e6ebf2;
  background: #171e2a;
  border: 1px solid var(--border);
}

.market-tab span {
  color: var(--green);
}

.asset-selector {
  display: flex;
  align-items: center;
  gap: 18px;
}

.asset-label {
  display: block;
  color: var(--muted);
  font-size: 8px;
  margin-bottom: 3px;
}

.asset-selector strong {
  font-size: 11px;
}

.asset-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.asset-price span {
  color: var(--green);
  font-size: 8px;
}

.asset-arrow {
  color: var(--muted);
  background: transparent;
}


/* ================================
   TERMINAL
================================ */

.terminal {
  width: 100%;
}


/* ================================
   CHART
================================ */

.chart-section {
  background: #0b1019;
  border-bottom: 1px solid var(--border);
}

.chart-top {
  height: 55px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 15px;
  position: relative;
  z-index: 5;
}

.chart-market {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.chart-market strong {
  font-size: 10px;
}

.chart-market span {
  color: #7e8a9d;
  font-size: 8px;
}

.chart-market em {
  color: var(--green);
  font-style: normal;
  margin-left: 4px;
}

.historical {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  background: #ef4058;
  color: white;
  padding: 9px 15px;
  border-radius: 18px;
  font-size: 9px;
  font-weight: 700;
}

.chart-percent {
  border: 1px solid var(--border);
  background: #141b27;
  color: #8994a6;
  padding: 7px 10px;
  border-radius: 4px;
  font-size: 9px;
}

.chart-wrapper {
  height: 420px;
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(rgba(35, 44, 59, 0.25) 1px, transparent 1px),
    linear-gradient(90deg, rgba(35, 44, 59, 0.25) 1px, transparent 1px);
  background-size: 80px 65px;
}

#priceChart {
  width: 100%;
  height: 100%;
  display: block;
  position: relative;
  z-index: 2;
}

.right-axis {
  position: absolute;
  right: 7px;
  top: 18px;
  bottom: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #536073;
  font-size: 8px;
  z-index: 3;
  pointer-events: none;
}

.chart-tools {
  position: absolute;
  bottom: 12px;
  left: 9px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  z-index: 5;
}

.chart-tools button {
  width: 30px;
  height: 30px;
  background: #151d29;
  color: #a3adbc;
  border: 1px solid var(--border);
  border-radius: 7px;
  font-size: 17px;
}

.chart-tools button:last-child {
  color: var(--green);
}


/* ================================
   DIGITS
================================ */

.digits {
  height: 60px;
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  border-top: 1px solid var(--border);
  background: #0d131d;
}

.digits button {
  color: #7b8798;
  background: transparent;
  border-right: 1px solid rgba(37, 46, 61, 0.5);
  font-size: 11px;
  position: relative;
}

.digits button small {
  display: block;
  font-size: 7px;
  margin-top: 4px;
  color: #4e5a6c;
}

.digits button.selected {
  color: var(--green);
  background: rgba(0, 201, 139, 0.08);
}

.digits button.selected small {
  color: #0c9870;
}


/* ================================
   TRADE PANEL
================================ */

.trade-panel {
  background: #0b1019;
}


/* AUTO / MANUAL */

.mode-selector {
  display: grid;
  grid-template-columns: 1fr 1fr;
  height: 70px;
  border-bottom: 1px solid var(--border);
}

.mode {
  color: #6c7789;
  background: transparent;
  font-size: 9px;
  font-weight: 700;
  position: relative;
}

.mode span {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #687282;
  margin-right: 5px;
}

.mode.active {
  color: var(--green);
  background: rgba(0, 201, 139, 0.06);
}

.mode.active span {
  background: var(--green);
}


/* STAKE */

.stake-row {
  height: 100px;
  display: grid;
  grid-template-columns: 70px 1fr 70px 1fr;
  border-bottom: 1px solid var(--border);
}

.stake-control {
  background: #0c121c;
  color: #697587;
  font-size: 22px;
  border-right: 1px solid var(--border);
}

.stake-display {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border-right: 1px solid var(--border);
}

.stake-display > span {
  color: #6c7789;
  font-size: 8px;
  font-weight: 700;
  margin-bottom: 6px;
}

.stake-display strong {
  font-size: 18px;
}

.stake-display small {
  color: #667286;
  font-size: 11px;
  margin-right: 4px;
}

.ai-scanner {
  background: linear-gradient(135deg, #17132e, #24184b);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.ai-scanner strong {
  color: #8f7bf2;
  font-size: 10px;
}

.ai-scanner span {
  color: #62588d;
  font-size: 8px;
  margin-top: 5px;
}


/* SETTINGS */

.trade-settings {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  height: 76px;
  border-bottom: 1px solid var(--border);
}

.setting {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1px solid var(--border);
}

.setting span {
  font-size: 8px;
  font-weight: 800;
  margin-bottom: 8px;
}

.setting strong {
  font-size: 12px;
}

.green-label {
  color: var(--green);
}

.red-label {
  color: #e64961;
}

.yellow-label {
  color: #c7a638;
}


/* SESSION */

.session-row {
  height: 65px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  color: #687486;
  font-size: 8px;
}

.session-dot {
  width: 5px;
  height: 5px;
  background: #667285;
  display: inline-block;
  border-radius: 50%;
  margin-right: 4px;
}

#sessionProfit {
  color: var(--green);
  font-size: 11px;
}


/* CONTRACT DIGITS */

.contract-digits {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  height: 38px;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.contract-digits button {
  background: #0c121c;
  color: #657184;
  border-right: 1px solid #1b2431;
  font-size: 9px;
}

.contract-digits button.active {
  background: rgba(0, 201, 139, 0.13);
  color: var(--green);
}


/* TRADE BUTTONS */

.trade-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  height: 98px;
}

.trade-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  color: white;
  transition: 0.15s ease;
}

.trade-button:hover {
  filter: brightness(1.07);
}

.trade-button:active {
  transform: scale(0.99);
}

.trade-button.up {
  background: #00c58a;
}

.trade-button.down {
  background: #ff2050;
}

.trade-arrow {
  font-size: 24px;
  font-weight: 800;
}

.trade-name {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  font-size: 13px;
  font-weight: 800;
}

.trade-name small {
  font-size: 8px;
  opacity: 0.7;
  margin-top: 5px;
}


/* ================================
   POSITIONS / HISTORY
================================ */

.positions-section,
.history-section {
  background: #0b1019;
  border-top: 8px solid #070b11;
  padding: 20px 16px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.section-heading div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.section-heading strong {
  font-size: 13px;
}

.section-heading span {
  color: var(--muted);
  font-size: 8px;
}

.section-heading button {
  background: #151c28;
  color: #7f8a9c;
  border: 1px solid var(--border);
  padding: 7px 12px;
  border-radius: 7px;
  font-size: 8px;
}

.empty-position,
.empty-history {
  border: 1px dashed #263041;
  border-radius: 10px;
  padding: 25px 15px;
  text-align: center;
  color: var(--muted);
}

.empty-position span {
  display: block;
  font-size: 24px;
  margin-bottom: 8px;
}

.empty-position strong {
  display: block;
  color: #8a95a5;
  font-size: 10px;
}

.empty-position small {
  display: block;
  margin-top: 5px;
  font-size: 8px;
}

.position-card,
.history-card {
  background: #111823;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 13px;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.position-card-left,
.history-card-left {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.position-card strong,
.history-card strong {
  font-size: 10px;
}

.position-card span,
.history-card span {
  color: var(--muted);
  font-size: 8px;
}

.position-value {
  color: var(--green);
  font-size: 11px;
  font-weight: 800;
}

.history-win {
  color: var(--green);
}

.history-loss {
  color: var(--red);
}


/* ================================
   BOTTOM NAV
================================ */

.bottom-nav {
  display: none;
}


/* ================================
   SIDE MENU
================================ */

.menu-overlay {
  display: none;
}

.side-menu {
  width: var(--sidebar-width);
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: #0a0f17;
  border-right: 1px solid var(--border);
  transform: translateX(-100%);
  transition: transform 0.25s ease;
  display: flex;
  flex-direction: column;
}

.side-menu.open {
  transform: translateX(0);
}

.side-header {
  height: 70px;
  padding: 0 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-icon {
  width: 32px;
  height: 32px;
}

.brand strong {
  display: block;
  font-size: 13px;
}

.brand span {
  display: block;
  color: var(--muted);
  font-size: 8px;
  margin-top: 3px;
}

.close-menu {
  background: transparent;
  color: #687487;
  font-size: 25px;
}

.profile-card {
  padding: 20px 18px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid var(--border);
}

.profile-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--green);
  color: #02150f;
  display: grid;
  place-items: center;
  font-weight: 800;
}

.profile-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.profile-info strong {
  font-size: 12px;
}

.profile-info span {
  color: var(--muted);
  font-size: 9px;
}

.side-navigation {
  padding: 8px 0;
  overflow-y: auto;
  flex: 1;
}

.side-link {
  min-height: 46px;
  padding: 0 18px;
  display: flex;
  align-items: center;
  gap: 13px;
  color: #a4adbb;
  font-size: 11px;
}

.side-link > span:first-child {
  width: 18px;
  color: #7d8797;
  text-align: center;
}

.side-link small {
  margin-left: auto;
  color: #687487;
  font-size: 16px;
}

.side-link.active {
  background: rgba(0, 201, 139, 0.08);
  color: var(--green);
}

.side-link.active > span:first-child {
  color: var(--green);
}

.position-count {
  margin-left: auto;
  background: #18212e;
  color: var(--muted);
  padding: 3px 6px;
  border-radius: 10px;
  font-size: 7px;
}

.menu-divider {
  height: 1px;
  background: var(--border);
  margin: 7px 0;
}

.refer-link {
  color: #a17cf4;
}

.refer-link > span:first-child {
  color: #a17cf4;
}

.theme-row {
  height: 46px;
  padding: 0 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #a4adbb;
  font-size: 11px;
}

.theme-icon {
  color: #9ca5b4;
  margin-right: 10px;
}

.switch {
  width: 46px;
  height: 24px;
  border-radius: 20px;
  background: #263041;
  padding: 3px;
}

.switch span {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: white;
  display: block;
  transition: 0.2s;
}

.switch.active {
  background: var(--green);
}

.switch.active span {
  transform: translateX(22px);
}

.logout-btn {
  margin: 10px 15px 5px;
  height: 45px;
  border-radius: 8px;
  color: #ff5478;
  background: rgba(255, 36, 83, 0.06);
  text-align: left;
  padding: 0 15px;
  font-size: 11px;
}

.logout-btn span {
  margin-right: 10px;
}

.menu-footer {
  height: 42px;
  border-top: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: #566173;
  font-size: 7px;
}

.online-dot {
  width: 5px;
  height: 5px;
  background: var(--green);
  border-radius: 50%;
}


/* ================================
   TOAST
================================ */

.toast {
  position: fixed;
  left: 50%;
  bottom: 25px;
  transform: translate(-50%, 100px);
  background: #151e2b;
  border: 1px solid #283446;
  color: white;
  border-radius: 9px;
  padding: 11px 15px;
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 9px;
  z-index: 3000;
  transition: 0.3s ease;
  box-shadow: 0 10px 40px rgba(0,0,0,0.35);
}

.toast.show {
  transform: translate(-50%, 0);
}

.toast-icon {
  width: 19px;
  height: 19px;
  display: grid;
  place-items: center;
  background: var(--green);
  color: #001a12;
  border-radius: 50%;
  font-weight: 900;
}


/* ================================
   DESKTOP
================================ */

@media (min-width: 900px) {

  body {
    padding-left: 0;
  }

  .app {
    max-width: 1180px;
    margin: 0 auto;
    box-shadow: 0 0 80px rgba(0,0,0,0.3);
  }

  .topbar {
    height: 68px;
  }

  .chart-wrapper {
    height: 500px;
  }

  .trade-panel {
    max-width: 100%;
  }

  .positions-section,
  .history-section {
    padding: 25px;
  }

}


/* ================================
   MOBILE
================================ */

@media (max-width: 600px) {

  :root {
    --sidebar-width: 292px;
  }

  .topbar {
    height: 56px;
    padding: 0 9px;
  }

  .mobile-brand {
    font-size: 12px;
  }

  .mobile-logo {
    width: 24px;
    height: 24px;
    border-radius: 6px;
  }

  .demo-badge {
    font-size: 7px;
    padding: 4px 7px;
  }

  .top-actions {
    gap: 5px;
  }

  .balance-btn {
    padding: 5px 7px;
  }

  .balance-btn small {
    display: none;
  }

  .balance-btn strong {
    font-size: 9px;
  }

  .deposit-btn {
    font-size: 8px;
    padding: 8px 10px;
  }

  .notification-btn {
    font-size: 17px;
  }

  .market-bar {
    min-height: 49px;
    padding: 5px 7px;
  }

  .market-tabs {
    gap: 1px;
    overflow-x: auto;
  }

  .market-tab {
    white-space: nowrap;
    font-size: 8px;
    padding: 7px 8px;
  }

  .asset-selector {
    display: none;
  }

  .chart-wrapper {
    height: 410px;
  }

  .chart-top {
    height: 48px;
  }

  .historical {
    font-size: 7px;
    padding: 7px 10px;
  }

  .chart-percent {
    font-size: 7px;
    padding: 6px;
  }

  .digits {
    height: 53px;
  }

  .digits button {
    font-size: 9px;
  }

  .digits button small {
    font-size: 6px;
  }

  .mode-selector {
    height: 65px;
  }

  .stake-row {
    height: 88px;
    grid-template-columns: 48px 1fr 48px 1.1fr;
  }

  .stake-control {
    font-size: 19px;
  }

  .stake-display strong {
    font-size: 16px;
  }

  .ai-scanner strong {
    font-size: 8px;
  }

  .ai-scanner span {
    font-size: 6px;
  }

  .trade-settings {
    height: 70px;
  }

  .setting span {
    font-size: 6px;
  }

  .setting strong {
    font-size: 10px;
  }

  .session-row {
    height: 55px;
  }

  .trade-buttons {
    height: 91px;
  }

  .trade-button {
    gap: 8px;
  }

  .trade-arrow {
    font-size: 20px;
  }

  .trade-name {
    font-size: 11px;
  }

  .trade-name small {
    font-size: 7px;
  }

  .bottom-nav {
    position: sticky;
    bottom: 0;
    height: 60px;
    background: #0d131d;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr 1fr;
    z-index: 100;
  }

  .bottom-link {
    position: relative;
    background: transparent;
    color: #647083;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    flex-direction: column;
    font-size: 8px;
  }

  .bottom-link span {
    font-size: 17px;
  }

  .bottom-link.active {
    color: var(--green);
  }

  .bottom-link b {
    position: absolute;
    top: 8px;
    margin-left: 22px;
    background: var(--red);
    color: white;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 7px;
  }

  .positions-section,
  .history-section {
    padding: 18px 10px;
  }

}


/* VERY SMALL PHONES */

@media (max-width: 380px) {

  .demo-badge {
    display: none;
  }

  .notification-btn {
    display: none;
  }

  .chart-wrapper {
    height: 360px;
  }

  .stake-row {
    grid-template-columns: 42px 1fr 42px 1fr;
  }

  .ai-scanner strong {
    font-size: 7px;
  }

  .trade-name small {
    display: none;
  }

}
