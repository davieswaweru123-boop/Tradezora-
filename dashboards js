document.addEventListener("DOMContentLoaded", () => {

  /* =========================================
     USER
  ========================================= */

  const savedUser = localStorage.getItem("tradezoraDemoUser");

  let user = {
    name: "Trader",
    email: "demo@tradezora.com"
  };

  if (savedUser) {
    try {
      user = JSON.parse(savedUser);
    } catch (error) {
      console.log("Using demo user.");
    }
  }

  const profileName = document.getElementById("profileName");
  const profileEmail = document.getElementById("profileEmail");
  const profileAvatar = document.getElementById("profileAvatar");

  if (profileName) {
    profileName.textContent = user.name || "Trader";
  }

  if (profileEmail) {
    profileEmail.textContent = user.email || "demo@tradezora.com";
  }

  if (profileAvatar) {
    profileAvatar.textContent =
      (user.name || "T").charAt(0).toUpperCase();
  }


  /* =========================================
     DEMO ACCOUNT
  ========================================= */

  let balance = Number(
    localStorage.getItem("tradezoraDemoBalance")
  );

  if (!Number.isFinite(balance)) {
    balance = 10;
  }

  let stake = Number(
    localStorage.getItem("tradezoraDemoStake")
  );

  if (!Number.isFinite(stake)) {
    stake = 10;
  }

  let positions = [];
  let history = [];


  const balanceDisplay =
    document.getElementById("balanceDisplay");

  const stakeValue =
    document.getElementById("stakeValue");

  function updateBalance() {
    if (balanceDisplay) {
      balanceDisplay.textContent =
        "$" + balance.toFixed(2);
    }

    localStorage.setItem(
      "tradezoraDemoBalance",
      balance.toFixed(2)
    );
  }

  function updateStake() {
    if (stakeValue) {
      stakeValue.textContent =
        stake.toFixed(0);
    }

    localStorage.setItem(
      "tradezoraDemoStake",
      stake.toFixed(0)
    );
  }

  updateBalance();
  updateStake();


  /* =========================================
     SIDE MENU
  ========================================= */

  const menuBtn =
    document.getElementById("menuBtn");

  const closeMenu =
    document.getElementById("closeMenu");

  const sideMenu =
    document.getElementById("sideMenu");

  const menuOverlay =
    document.getElementById("menuOverlay");

  function openMenu() {
    sideMenu.classList.add("open");
    menuOverlay.style.display = "block";
    document.body.style.overflow = "hidden";
  }

  function closeSideMenu() {
    sideMenu.classList.remove("open");
    menuOverlay.style.display = "none";
    document.body.style.overflow = "";
  }

  if (menuBtn) {
    menuBtn.addEventListener("click", openMenu);
  }

  if (closeMenu) {
    closeMenu.addEventListener(
      "click",
      closeSideMenu
    );
  }

  if (menuOverlay) {
    menuOverlay.addEventListener(
      "click",
      closeSideMenu
    );
  }


  /* =========================================
     LOGOUT
  ========================================= */

  const logoutBtn =
    document.getElementById("logoutBtn");

  if (logoutBtn) {

    logoutBtn.addEventListener("click", () => {

      localStorage.removeItem(
        "tradezoraDemoUser"
      );

      window.location.href = "auth.html";

    });

  }


  /* =========================================
     THEME SWITCH
  ========================================= */

  const themeSwitch =
    document.getElementById("themeSwitch");

  if (themeSwitch) {

    themeSwitch.addEventListener("click", () => {

      themeSwitch.classList.toggle("active");

      showToast(
        themeSwitch.classList.contains("active")
          ? "Dark theme enabled"
          : "Theme switched"
      );

    });

  }


  /* =========================================
     MARKET PRICE
  ========================================= */

  let marketPrice = 9616.09;
  let previousPrice = marketPrice;

  const marketPriceElement =
    document.getElementById("marketPrice");

  const chartPriceElement =
    document.getElementById("chartPrice");

  const marketChangeElement =
    document.getElementById("marketChange");

  const chartChangeElement =
    document.getElementById("chartChange");

  function updateMarketPrice() {

    previousPrice = marketPrice;

    const movement =
      (Math.random() - 0.5) * 7;

    marketPrice += movement;

    const change =
      ((marketPrice - 9600) / 9600) * 100;

    const formattedPrice =
      marketPrice.toFixed(2);

    const sign =
      change >= 0 ? "+" : "";

    if (marketPriceElement) {
      marketPriceElement.textContent =
        formattedPrice;
    }

    if (chartPriceElement) {
      chartPriceElement.textContent =
        formattedPrice;
    }

    if (marketChangeElement) {
      marketChangeElement.textContent =
        sign + change.toFixed(2) + "%";

      marketChangeElement.style.color =
        change >= 0
          ? "#00c98b"
          : "#ff2453";
    }

    if (chartChangeElement) {
      chartChangeElement.textContent =
        sign + change.toFixed(2) + "%";

      chartChangeElement.style.color =
        change >= 0
          ? "#00c98b"
          : "#ff2453";
    }

    chartData.push(marketPrice);

    if (chartData.length > 70) {
      chartData.shift();
    }

    drawChart();
  }


  /* =========================================
     CHART
  ========================================= */

  const canvas =
    document.getElementById("priceChart");

  const ctx =
    canvas ? canvas.getContext("2d") : null;

  let chartData = [];

  let chartZoom = 1;

  function createInitialChart() {

    let price = 9610;

    chartData = [];

    for (let i = 0; i < 70; i++) {

      price +=
        (Math.random() - 0.5) * 8;

      chartData.push(price);

    }

    chartData[chartData.length - 1] =
      marketPrice;

  }

  function resizeCanvas() {

    if (!canvas) return;

    const rect =
      canvas.getBoundingClientRect();

    const dpr =
      window.devicePixelRatio || 1;

    canvas.width =
      rect.width * dpr;

    canvas.height =
      rect.height * dpr;

    ctx.setTransform(
      dpr,
      0,
      0,
      dpr,
      0,
      0
    );

    drawChart();
  }

  function drawChart() {

    if (!canvas || !ctx || chartData.length < 2) {
      return;
    }

    const width =
      canvas.clientWidth;

    const height =
      canvas.clientHeight;

    ctx.clearRect(
      0,
      0,
      width,
      height
    );

    const min =
      Math.min(...chartData) - 8;

    const max =
      Math.max(...chartData) + 8;

    const range =
      max - min || 1;

    const paddingLeft = 10;
    const paddingRight = 65;
    const paddingTop = 25;
    const paddingBottom = 18;

    const chartWidth =
      width -
      paddingLeft -
      paddingRight;

    const chartHeight =
      height -
      paddingTop -
      paddingBottom;

    const points = [];

    chartData.forEach((value, index) => {

      const x =
        paddingLeft +
        (index / (chartData.length - 1)) *
          chartWidth;

      const y =
        paddingTop +
        ((max - value) / range) *
          chartHeight;

      points.push({ x, y });

    });


    /* AREA */

    ctx.beginPath();

    points.forEach((point, index) => {

      if (index === 0) {
        ctx.moveTo(
          point.x,
          point.y
        );
      } else {
        ctx.lineTo(
          point.x,
          point.y
        );
      }

    });

    ctx.lineTo(
      points[points.length - 1].x,
      height
    );

    ctx.lineTo(
      points[0].x,
      height
    );

    ctx.closePath();

    const gradient =
      ctx.createLinearGradient(
        0,
        0,
        0,
        height
      );

    gradient.addColorStop(
      0,
      "rgba(128, 143, 166, 0.18)"
    );

    gradient.addColorStop(
      1,
      "rgba(128, 143, 166, 0.01)"
    );

    ctx.fillStyle = gradient;
    ctx.fill();


    /* LINE */

    ctx.beginPath();

    points.forEach((point, index) => {

      if (index === 0) {
        ctx.moveTo(
          point.x,
          point.y
        );
      } else {

        const previous =
          points[index - 1];

        const controlX =
          (previous.x + point.x) / 2;

        ctx.quadraticCurveTo(
          controlX,
          previous.y,
          point.x,
          point.y
        );

      }

    });

    ctx.strokeStyle =
      "#aab3c1";

    ctx.lineWidth = 2;

    ctx.lineJoin = "round";
    ctx.lineCap = "round";

    ctx.stroke();


    /* LAST POINT */

    const last =
      points[points.length - 1];

    ctx.beginPath();

    ctx.arc(
      last.x,
      last.y,
      3,
      0,
      Math.PI * 2
    );

    ctx.fillStyle =
      "#00c98b";

    ctx.fill();

  }


  createInitialChart();

  setTimeout(
    resizeCanvas,
    100
  );

  window.addEventListener(
    "resize",
    resizeCanvas
  );


  /* =========================================
     CHART CONTROLS
  ========================================= */

  const zoomIn =
    document.getElementById("zoomIn");

  const zoomOut =
    document.getElementById("zoomOut");

  const resetChart =
    document.getElementById("resetChart");

  if (zoomIn) {

    zoomIn.addEventListener(
      "click",
      () => {

        chartZoom =
          Math.min(
            chartZoom + 0.1,
            2
          );

        showToast(
          "Chart zoom: " +
          Math.round(chartZoom * 100) +
          "%"
        );

      }
    );

  }

  if (zoomOut) {

    zoomOut.addEventListener(
      "click",
      () => {

        chartZoom =
          Math.max(
            chartZoom - 0.1,
            0.5
          );

        showToast(
          "Chart zoom: " +
          Math.round(chartZoom * 100) +
          "%"
        );

      }
    );

  }

  if (resetChart) {

    resetChart.addEventListener(
      "click",
      () => {

        chartZoom = 1;

        createInitialChart();
        drawChart();

        showToast(
          "Chart reset"
        );

      }
    );

  }


  setInterval(
    updateMarketPrice,
    1800
  );


  /* =========================================
     STAKE CONTROLS
  ========================================= */

  const stakeMinus =
    document.getElementById("stakeMinus");

  const stakePlus =
    document.getElementById("stakePlus");


  if (stakeMinus) {

    stakeMinus.addEventListener(
      "click",
      () => {

        stake =
          Math.max(
            1,
            stake - 1
          );

        updateStake();

      }
    );

  }


  if (stakePlus) {

    stakePlus.addEventListener(
      "click",
      () => {

        stake =
          Math.min(
            1000,
            stake + 1
          );

        updateStake();

      }
    );

  }


  /* =========================================
     AUTO / MANUAL
  ========================================= */

  const autoMode =
    document.getElementById("autoMode");

  const manualMode =
    document.getElementById("manualMode");

  if (autoMode) {

    autoMode.addEventListener(
      "click",
      () => {

        autoMode.classList.add("active");
        manualMode.classList.remove("active");

        showToast(
          "Auto mode selected"
        );

      }
    );

  }

  if (manualMode) {

    manualMode.addEventListener(
      "click",
      () => {

        manualMode.classList.add("active");
        autoMode.classList.remove("active");

        showToast(
          "Manual mode selected"
        );

      }
    );

  }


  /* =========================================
     DIGITS
  ========================================= */

  document
    .querySelectorAll(
      ".digits button, .contract-digits button"
    )
    .forEach(button => {

      button.addEventListener(
        "click",
        () => {

          const parent =
            button.parentElement;

          parent
            .querySelectorAll("button")
            .forEach(item =>
              item.classList.remove(
                "selected",
                "active"
              )
            );

          button.classList.add(
            parent.classList.contains(
              "contract-digits"
            )
              ? "active"
              : "selected"
          );

        }
      );

    });


  /* =========================================
     TRADE EXECUTION
  ========================================= */

  const upButton =
    document.getElementById("upButton");

  const downButton =
    document.getElementById("downButton");


  function executeTrade(direction) {

    if (stake > balance) {

      showToast(
        "Demo balance is too low"
      );

      return;

    }


    balance -= stake;

    updateBalance();


    const trade = {

      id:
        Date.now(),

      direction,

      stake,

      entry:
        marketPrice,

      time:
        new Date().toLocaleTimeString(
          [],
          {
            hour: "2-digit",
            minute: "2-digit"
          }
        )

    };


    positions.push(trade);

    updatePositions();


    showToast(
      direction === "UP"
        ? "Demo UP trade opened"
        : "Demo DOWN trade opened"
    );


    /*
      Simulate contract settlement
      after a few seconds.
    */

    setTimeout(
      () => settleTrade(trade.id),
      5000
    );

  }


  if (upButton) {

    upButton.addEventListener(
      "click",
      () => executeTrade("UP")
    );

  }


  if (downButton) {

    downButton.addEventListener(
      "click",
      () => executeTrade("DOWN")
    );

  }


  /* =========================================
     SETTLE DEMO TRADE
  ========================================= */

  function settleTrade(id) {

    const index =
      positions.findIndex(
        trade => trade.id === id
      );

    if (index === -1) {
      return;
    }


    const trade =
      positions[index];

    const current =
      marketPrice;


    const won =
      trade.direction === "UP"
        ? current >= trade.entry
        : current <= trade.entry;


    /*
      Demo payout only.
    */

    const payout =
      won
        ? trade.stake * 1.85
        : 0;


    if (won) {
      balance += payout;
    }


    updateBalance();


    history.unshift({

      ...trade,

      exit:
        current,

      result:
        won ? "WIN" : "LOSS",

      payout

    });


    positions.splice(
      index,
      1
    );


    updatePositions();
    updateHistory();


    showToast(
      won
        ? "Demo trade won +$" +
          payout.toFixed(2)
        : "Demo trade lost"
    );

  }


  /* =========================================
     POSITIONS
  ========================================= */

  const positionsList =
    document.getElementById("positionsList");

  const positionCount =
    document.getElementById("positionCount");

  const bottomPositionCount =
    document.getElementById(
      "bottomPositionCount"
    );

  const openPositionLabel =
    document.getElementById(
      "openPositionLabel"
    );


  function updatePositions() {

    const count =
      positions.length;


    if (positionCount) {
      positionCount.textContent =
        count;
    }

    if (bottomPositionCount) {
      bottomPositionCount.textContent =
        count;
    }

    if (openPositionLabel) {
      openPositionLabel.textContent =
        count +
        (count === 1
          ? " active"
          : " active");
    }


    if (!positionsList) {
      return;
    }


    if (positions.length === 0) {

      positionsList.innerHTML = `
        <div class="empty-position">
          <span>◷</span>
          <strong>No open demo positions</strong>
          <small>Your demo trades will appear here.</small>
        </div>
      `;

      return;

    }


    positionsList.innerHTML =
      positions
        .map(trade => `
          <div class="position-card">

            <div class="position-card-left">

              <strong>
                ${trade.direction === "UP"
                  ? "↑ UP"
                  : "↓ DOWN"}
              </strong>

              <span>
                Volatility 10 (1s)
                · Entry ${trade.entry.toFixed(2)}
              </span>

            </div>

            <div class="position-value">
              $${trade.stake.toFixed(2)}
            </div>

          </div>
        `)
        .join("");

  }


  /* =========================================
     HISTORY
  ========================================= */

  const historyList =
    document.getElementById(
      "historyList"
    );


  function updateHistory() {

    if (!historyList) {
      return;
    }


    if (history.length === 0) {

      historyList.innerHTML =
        `<div class="empty-history">
          No demo trades yet.
        </div>`;

      return;

    }


    historyList.innerHTML =
      history
        .slice(0, 20)
        .map(trade => {

          const resultClass =
            trade.result === "WIN"
              ? "history-win"
              : "history-loss";

          const resultText =
            trade.result === "WIN"
              ? "+$" +
                trade.payout.toFixed(2)
              : "-$" +
                trade.stake.toFixed(2);


          return `
            <div class="history-card">

              <div class="history-card-left">

                <strong>
                  ${trade.direction === "UP"
                    ? "↑ UP"
                    : "↓ DOWN"}
                </strong>

                <span>
                  ${trade.time}
                  · ${trade.result}
                </span>

              </div>

              <strong class="${resultClass}">
                ${resultText}
              </strong>

            </div>
          `;

        })
        .join("");

  }


  /* =========================================
     CLEAR POSITIONS
  ========================================= */

  const clearPositions =
    document.getElementById(
      "clearPositions"
    );

  if (clearPositions) {

    clearPositions.addEventListener(
      "click",
      () => {

        positions = [];

        updatePositions();

        showToast(
          "Open demo positions cleared"
        );

      }
    );

  }


  /* =========================================
     BOTTOM POSITIONS BUTTON
  ========================================= */

  const positionsNav =
    document.getElementById(
      "positionsNav"
    );

  if (positionsNav) {

    positionsNav.addEventListener(
      "click",
      () => {

        const section =
          document.getElementById(
            "positions"
          );

        if (section) {

          section.scrollIntoView({
            behavior: "smooth"
          });

        }

      }
    );

  }


  /* =========================================
     TOAST
  ========================================= */

  const toast =
    document.getElementById("toast");

  const toastMessage =
    document.getElementById(
      "toastMessage"
    );

  let toastTimer;


  function showToast(message) {

    if (!toast || !toastMessage) {
      return;
    }

    toastMessage.textContent =
      message;

    toast.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer =
      setTimeout(
        () => {
          toast.classList.remove("show");
        },
        2200
      );

  }


  /* =========================================
     INITIALIZE
  ========================================= */

  updatePositions();
  updateHistory();
  updateBalance();
  updateStake();

  console.log(
    "TradeZora demo trading terminal initialized."
  );

});
